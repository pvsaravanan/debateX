# OpenRouter API Key for free tier and diverse models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key for high performance and primary Chairman model
GROQ_API_KEY=your_groq_api_key_here

# Optional: pre-flight self-consistency probing (3 temperature samples per model).
# Multiplies API call volume — keep off on free-tier rate limits.
ENABLE_METACOGNITION=false
